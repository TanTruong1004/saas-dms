<odoo>
    <data>

        <record model="ir.ui.view" id="dropbox_credentials_tree">
            <field name="name">Dropbox Credentials Tree</field>
            <field name="model">dropbox.credentials</field>
            <field name="arch" type="xml">
                <tree string="Dropbox credentials">
                    <field name="name"/>
                    <field name="folder_path"/>
                    <field name="current_account"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="dropbox_credentials_kanban">
            <field name="name">Dropbox Credentials Tree</field>
            <field name="model">dropbox.credentials</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click o_res_partner_kanban">
                                <div class="oe_kanban_details">
                                    <h4>
                                        <a type="open">
                                            <field name="name"/>
                                        </a>
                                    </h4>

                                    <ul>
                                        <strong>Access Token: *************************************************</strong>
                                        <li>
                                            <strong>Folder Path:</strong>
                                            <field name="folder_path"/>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record model="ir.ui.view" id="dropbox_credentials_form">
            <field name="name">Dropbox Credentials Form</field>
            <field name="model">dropbox.credentials</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button type="object" name="action_check_code_dropbox" string="Check Code Dropbox"
                                class="oe_highlight"/>
                        <button type="object" name="action_refresh_code_dropbox" string="Refresh Code Dropbox"
                                class="oe_highlight" invisible="not authorization_code"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="True"/>
                                <field name="access_token" password="True" readonly="True"/>
                                <field name="link_url" required="True"/>
                                <field name="client_id" required="True"/>
                                <field name="client_secret" required="True"/>
                                <field name="current_account" widget="boolean_toggle"/>
                                <field name="dropbox_data_limit_mb" required="True"/>
                            </group>

                            <group>
                                <field name="folder_path"/>
                                <field name="authorization_code"/>
                                <field name="refresh_token" readonly="True"/>
                                <label for="expires_at" string="Expires At" readonly="True"/>
                                <div name="expires_at">
                                    <div>
                                        <field name="expires_at" class="oe_inline"/>
                                        <span class="ms-3">Hours</span>
                                    </div>

                                </div>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="dropbox_credentials_action_window">
            <field name="name">Dropbox Credentials</field>
            <field name="res_model">dropbox.credentials</field>
            <field name="view_mode">kanban,tree,form</field>
        </record>
    </data>
</odoo>