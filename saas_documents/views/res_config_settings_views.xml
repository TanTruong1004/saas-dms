<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_inherit_sdocument_view" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.sdocument.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="documents.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='documents']" position="inside">
                <block>
                    <setting company_dependent="1" help="Configure to search by file contents">
                        <field name="is_file_content"/>
                        <div class="content-group" invisible="not is_file_content">
                            <div class="row mt16">
                                <label class="o_form_label col-lg-3" for="doc_url" string="Url Configuration"/>
                                <field name="doc_url" />
                            </div>
                        </div>
                    </setting>
                </block>
                <block>
                    <setting company_dependent="1" help="Configuration to upload files to dropbox">
                        <field name="is_upload_dropbox"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
