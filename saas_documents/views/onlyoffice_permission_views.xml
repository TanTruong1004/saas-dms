<odoo>
    <data>
        <record id="view_onlyoffice_permission_tree" model="ir.ui.view">
            <field name="name">onlyoffice.permission.tree</field>
            <field name="model">onlyoffice.permission</field>
            <field name="arch" type="xml">
                <tree string="OnlyOffice Permissions" create="false" editable="bottom">
                    <field name="code" readonly="true"/>
                    <field name="name"/>
                    <field name="description"/>
                </tree>
            </field>
        </record>

        <record model="ir.actions.act_window" id="onlyoffice_permission_action">
            <field name="name">Onlyoffice Permission</field>
            <field name="res_model">onlyoffice.permission</field>
            <field name="view_mode">tree</field>
        </record>
    </data>
</odoo>
