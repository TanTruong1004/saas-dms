<odoo>
    <data>
        <record id="documents_document_readonly_rule_inherit" model="ir.rule">
            <field name="name">Documents: readonly rule inherit</field>
            <field name="model_id" ref="model_documents_document"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">
                [
                '|',
                ('global_permission', '=', True),
                '|',
                ('document_share_access_ids.user_id', '=', user.id),
                '&amp;',
                ('folder_id.read_group_ids', 'in', [g.id for g in user.groups_id]),
                '|',
                ('folder_id.user_specific', '=', False),
                ('owner_id', '=', user.id)
                ]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
