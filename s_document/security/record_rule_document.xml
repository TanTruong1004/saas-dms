<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="documents_document_inherit_rule" model="ir.rule">
        <field name="name">Documents.document: folder write groups inherit</field>
        <field name="model_id" ref="model_documents_document"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['&amp;',
                                 '|',   '|',
                                        '&amp;',
                                              ('folder_id.group_ids', 'in', [g.id for g in user.groups_id]),
                                              '|',
                                                  ('folder_id.user_specific_write', '=', False),
                                                  ('owner_id', '=', user.id),
                                       '&amp;',
                                            ('folder_id.read_group_ids', '=', False),
                                            ('folder_id.group_ids', '=', False),
                                    ('message_is_follower', '=', True),
                                    '|',
                                       '|',
                                           '&amp;',
                                               ('owner_id', '!=', user.id),
                                            '|',
                                               ('state', '=', 'done'),
                                               ('create_uid', '=', user.id),
                                      '|',
                                         '&amp;',
                                              ('state', '!=', 'draft'),
                                              ('message_is_follower', '=', True),
                                          ('review_ids.reviewer_ids', 'in', user.id),
                                    ('owner_id', '=', user.id),
                                    ]

        </field>
    </record>

    <record id="documents_document_inherit_rule_global" model="ir.rule">
        <field name="name">Documents.document: global inherit</field>
        <field name="model_id" ref="model_documents_document"/>
        <field name="domain_force">[
            '|',
            ('folder_id.company_id', '=', False),
            '|',
            ('message_is_follower', '=', True),
            ('folder_id.company_id', 'in', company_ids)]
        </field>
    </record>

    <record id="documents_document_inherit_rule_read_only" model="ir.rule">
        <field name="name">Documents.document: readonly rule inherit</field>
        <field name="model_id" ref="model_documents_document"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[
            '&amp;',
            ('folder_id.read_group_ids', 'in', [g.id for g in user.groups_id]),
            '|',
            '|',
            '&amp;',
            ('folder_id.user_specific', '=', False),
            '|',
            '|',
            '&amp;',
            ('owner_id', '!=', user.id),
            '|',
            ('state', '=', 'done'),
            ('create_uid', '=', user.id),

            ('review_ids.reviewer_ids', 'in', user.id),
            ('owner_id', '=', user.id),
            '&amp;',
            ('folder_id.user_specific', '=', True),
            '|',
            '|',
            ('create_uid', '=', user.id),

            ('review_ids.reviewer_ids', 'in', user.id),
            ('owner_id', '=', user.id),
            '&amp;',
            ('message_is_follower', '=', True),
            ('state', '!=', 'draft')
        ]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
