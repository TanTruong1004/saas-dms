<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="documents_AttachmentViewer_inherit" owl="1" t-inherit="documents.FileViewer"
       t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'o-FileViewer-headerButton d-flex align-items-center px-3 cursor-pointer')]"
               position="attributes">
            <attribute name="class" separator=" " add="d-none"/>
        </xpath>

        <xpath expr="//div[contains(@class, 'o-FileViewer-download o-FileViewer-headerButton d-flex align-items-center px-3 cursor-pointer')]"
               position="attributes">
            <attribute name="class" separator=" " add="d-none"/>
        </xpath>

        <xpath expr="//div[@class='position-absolute bottom-0 d-flex']" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>
    </t>
</templates>
