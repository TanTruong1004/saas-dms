<odoo>
    <data>
        <record id="view_document_release_wizard_form" model="ir.ui.view">
            <field name="name">document.release.wizard.form</field>
            <field name="model">document.release.wizard</field>
            <field name="arch" type="xml">
                <form string="Document Release">
                    <group>
                        <field name="folder_id" readonly="1" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                        <field name="expiration_date"/>
                    </group>
                    <footer>
                        <button name="action_release_documents" string="Release"
                                type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
